[Desktop Entry]
Type=Application
Name=Amazon Music (Chromium)
Comment=Amazon Music in a Chromium app window with desktop media controls
Comment[pt_BR]=Amazon Music em uma janela Chromium com controles de mídia do desktop
Exec=amazon-music-pwa
